  m_text: "WASD \u2014 \u043A\u0430\u043C\u0435\u0440\u0430 \xB7 Q/E \u2014 \u043F\u043E\u0432\u043E\u0440\u043E\u0442
    \xB7 \u043A\u043E\u043B\u0435\u0441\u043E \u2014 \u0437\u0443\u043C \xB7 Z/C
    \u2014 \u044D\u0442\u0430\u0436 \u043D\u0438\u0436\u0435/\u0432\u044B\u0448\u0435
    \xB7 R \u2014 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0443
    \xB7 \u041F\u041A\u041C/Esc \u2014 \u043E\u0442\u043C\u0435\u043D\u0430 \xB7
    \u043F\u0440\u043E\u0431\u0435\u043B \u2014 \u043F\u0430\u0443\u0437\u0430 \xB7
    1\u20136 \u2014 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\n\u0427\u0438\u0442\u044B
    \u0432 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0435: F1 +10% \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F
    \xB7 F2 +10 \u0440\u0430\u0441\u0441\u0435\u043A\u0440\u0435\u0447. \xB7 F3 \u221210
    \u0434\u043E\u0432\u0435\u0440\u0438\u044F \xB7 F4 +10 000 \xB7 F5 +100 \u043E\u043F\u044B\u0442\u0430
    \xB7 F6 +1 \u0434\u0435\u043D\u044C"
