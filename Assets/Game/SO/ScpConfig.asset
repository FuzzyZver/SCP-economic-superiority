      RequiredClearance: 2
      Text: "\u0411\u0443\u0442\u044B\u043B\u043A\u0438 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F
        \u0432 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u043C\u043E\u043C \u0448\u043A\u0430\u0444\u0443
        \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.
        \u0423\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0442\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
        \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
        \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F."
    - Kind: 1
      Heading: 
      RequiredResearch: 0
      RequiredClearance: 2
      Text: "\u041D\u0430\u0431\u043E\u0440 \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0445
        \u0431\u0443\u0442\u044B\u043B\u043E\u043A \xAB\u041A\u043E\u043A\u0430-\u041A\u043E\u043B\u044B\xBB
        \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430.
        \u041D\u0430 \u0432\u043A\u0443\u0441 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
        \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
        \u043E\u0442 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u0430."
    - Kind: 1
      Heading: 
      RequiredResearch: 15
      RequiredClearance: 2
      Text: "\u041D\u0430\u043F\u0438\u0442\u043E\u043A \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
        \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u0438\u043B\u0438\u0432
        \u0441\u0438\u043B: \u0443 \u0438\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u043E\u0433\u043E
        \u0440\u0430\u0441\u0442\u0443\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        \u0438 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C.
        [\u0427\u0415\u0420\u041D\u041E\u0412\u0418\u041A]"
    - Kind: 2
      Heading: 
      RequiredResearch: 40
      RequiredClearance: 3
      Text: "\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0435 \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435
        \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442,
        \u043D\u043E \u0432\u0440\u0435\u0434\u0438\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0443.
        \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u0441\u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0434 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u043C
        \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C. [\u0427\u0415\u0420\u041D\u041E\u0412\u0418\u041A:
        \u0441\u0432\u0435\u0440\u0438\u0442\u044C \u0441 \u0432\u0438\u043A\u0438]"
