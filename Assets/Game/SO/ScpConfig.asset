        \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u0430.
        [\u0427\u0415\u0420\u041D\u041E\u0412\u0418\u041A: \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
