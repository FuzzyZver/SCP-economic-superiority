    - Kind: 0
      Heading: 
      RequiredResearch: 0
      RequiredClearance: 2
      Text: "\u041E\u0431\u044A\u0435\u043A\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u0432 \u0436\u0438\u043B\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u0435
        \u0434\u043B\u044F \u0433\u0443\u043C\u0430\u043D\u043E\u0438\u0434\u043E\u0432.
        \u0418\u0433\u0440\u0443\u0448\u043A\u0438 \u0438 \u043A\u043D\u0438\u0433\u0438
        \u0432\u044B\u0434\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u0438\u044E
        \u0441 \u043A\u0443\u0440\u0430\u0442\u043E\u0440\u043E\u043C. [\u0427\u0415\u0420\u041D\u041E\u0412\u0418\u041A:
        \u0441\u0432\u0435\u0440\u0438\u0442\u044C \u0441 \u0432\u0438\u043A\u0438]"
    - Kind: 1
      Heading: 
      RequiredResearch: 0
      RequiredClearance: 2
      Text: "\u0420\u0435\u0431\u0451\u043D\u043E\u043A, \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
        \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u043C\u0435\u0441\u0442\u043E
        \u0440\u0430\u0434\u0443\u0436\u043A\u0438 \u0438 \u0437\u0440\u0430\u0447\u043A\u0430
        \u0432\u0438\u0434\u043D\u043E \u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0435
        \u043D\u0435\u0431\u043E. \u0421\u043F\u043E\u043A\u043E\u0435\u043D, \u043F\u043E\u0441\u043B\u0443\u0448\u0435\u043D
        \u0438 \u043E\u0445\u043E\u0442\u043D\u043E \u0438\u0434\u0451\u0442 \u043D\u0430
        \u043A\u043E\u043D\u0442\u0430\u043A\u0442. [\u0427\u0415\u0420\u041D\u041E\u0412\u0418\u041A]"
    - Kind: 1
      Heading: 
      RequiredResearch: 20
      RequiredClearance: 3
      Text: "\u0417\u0430 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F
        \u043E\u0431\u044A\u0435\u043A\u0442 \u043D\u0438 \u0440\u0430\u0437\u0443
        \u043D\u0435 \u043F\u0440\u043E\u044F\u0432\u0438\u043B \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u043E\u0441\u0442\u0438
        \u0438 \u043D\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u0438\u043B \u0432\u0440\u0435\u0434\u0430
        \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0443. [\u0427\u0415\u0420\u041D\u041E\u0412\u0418\u041A]"
    - Kind: 2
      Heading: 
      RequiredResearch: 60
      RequiredClearance: 4
      Text: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439
