    Author: Moto42
    SourceUrl: 
    Sections:
    - Kind: 0
      Heading: 
      RequiredResearch: 0
      RequiredClearance: 2
      Text: "\u041E\u0431\u044A\u0435\u043A\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u0432 \u0437\u0430\u043F\u0435\u0440\u0442\u043E\u043C \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0435.
        \u0412\u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u043A\u0430\u043C\u0435\u0440\u0443
        \u2014 \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 \u0447\u0435\u043C
        \u0432\u0442\u0440\u043E\u0451\u043C. \u041E\u0431\u044A\u0435\u043A\u0442
        \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0440\u0436\u0430\u0442
        \u0432 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F, \u0430
        \u043F\u0435\u0440\u0435\u0434 \u043C\u043E\u0440\u0433\u0430\u043D\u0438\u0435\u043C
        \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E\u0442
        \u043A\u043E\u043B\u043B\u0435\u0433."
    - Kind: 1
      Heading: 
      RequiredResearch: 0
      RequiredClearance: 2
      Text: "\u0421\u0442\u0430\u0442\u0443\u044F \u0438\u0437 \u0431\u0435\u0442\u043E\u043D\u0430
        \u0438 \u0430\u0440\u043C\u0430\u0442\u0443\u0440\u044B \u0441\u043E \u0441\u043B\u0435\u0434\u0430\u043C\u0438
        \u0430\u044D\u0440\u043E\u0437\u043E\u043B\u044C\u043D\u043E\u0439 \u043A\u0440\u0430\u0441\u043A\u0438.
        \u041E\u0431\u044A\u0435\u043A\u0442 \u0436\u0438\u0432\u043E\u0439 \u0438
        \u043A\u0440\u0430\u0439\u043D\u0435 \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u0435\u043D."
    - Kind: 1
      Heading: 
      RequiredResearch: 10
      RequiredClearance: 2
      Text: "\u041F\u043E\u043A\u0430 \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442
        \u0441\u043C\u043E\u0442\u0440\u044F\u0442, \u043E\u043D \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u0435\u043D.
        \u0421\u0442\u043E\u0438\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
        \u0435\u0433\u043E \u0438\u0437 \u0432\u0438\u0434\u0443 \u0434\u0430\u0436\u0435
        \u043D\u0430 \u043C\u0438\u0433 \u2014 \u043E\u043D \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
        \u0441 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E."
    - Kind: 0
      Heading: 
      RequiredResearch: 25
      RequiredClearance: 3
      Text: "\u0420\u0430\u0437 \u0432 \u0434\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438
        \u043A\u0430\u043C\u0435\u0440\u0443 \u043E\u0447\u0438\u0449\u0430\u044E\u0442
        \u043E\u0442 \u0431\u0443\u0440\u043E\u0439 \u0441\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0438\u0438
        \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
        \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F.
        \u0423\u0431\u043E\u0440\u043A\u0430 \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0431\u0440\u0438\u0433\u0430\u0434\u043E\u0439 \u0441 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C
        \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u043C \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043E\u043C."
    - Kind: 2
