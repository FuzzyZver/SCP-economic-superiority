      Text: "\u0413\u0443\u043C\u0430\u043D\u043E\u0438\u0434 \u0440\u043E\u0441\u0442\u043E\u043C
        \u043E\u043A\u043E\u043B\u043E 1,9 \u043C, \u0432\u043D\u0435\u0448\u043D\u0435
        \u043F\u043E\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u0432\u0435\u043A\u043E\u0432\u043E\u0433\u043E
        \u0447\u0443\u043C\u043D\u043E\u0433\u043E \u0434\u043E\u043A\u0442\u043E\u0440\u0430.
        \u0420\u0430\u0437\u0443\u043C\u0435\u043D, \u0432\u0435\u0436\u043B\u0438\u0432,
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0441 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u043E\u043C."
    - Kind: 1
      Heading: 
      RequiredResearch: 15
      RequiredClearance: 3
      Text: "\u041F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u0435
        \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E.
        \u041E\u0431\u044A\u0435\u043A\u0442 \u0443\u0431\u0435\u0436\u0434\u0451\u043D,
        \u0447\u0442\u043E \u0431\u043E\u0440\u0435\u0442\u0441\u044F \u0441 \xAB\u041F\u043E\u0432\u0435\u0442\u0440\u0438\u0435\u043C\xBB,
        \u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u043D\u0430\u0434
        \u0442\u0435\u043B\u0430\u043C\u0438 \u0436\u0435\u0440\u0442\u0432 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438."
    - Kind: 2
      Heading: 
      RequiredResearch: 35
      RequiredClearance: 3
      Text: "\u041F\u043E\u0441\u043B\u0435 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439
        \u0442\u0435\u043B\u0430 \u043E\u0436\u0438\u0432\u0430\u044E\u0442 \u0438
        \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u044B\u043C\u0438.
        \u0422\u0430\u043A\u0438\u0435 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u044B
        \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442\u0441\u044F
        SCP-049-2."
    - Kind: 2
      Heading: 
      RequiredResearch: 60
      RequiredClearance: 4
      Text: "\u0418\u043D\u0442\u0435\u0440\u0432\u044C\u044E: \u043E\u0431\u044A\u0435\u043A\u0442
        \u043E\u0445\u043E\u0442\u043D\u0435\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0435\u0442,
        \u043A\u043E\u0433\u0434\u0430 \u0435\u043C\u0443 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
        \xAB\u043B\u0435\u0447\u0438\u0442\u044C\xBB. \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u044D\u0442\u043E \u0432 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0445
        \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E \u0432 \u0421\u043E\u0432\u0435\u0442
        O5. [\u0427\u0415\u0420\u041D\u041E\u0412\u0418\u041A]"
